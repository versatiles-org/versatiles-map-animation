{
	"name": "versatiles-map-animator",
	"version": "0.2.0",
	"description": "Tool for composing map camera animations on a timeline (VersaTiles).",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/versatiles-org/versatiles-map-animator.git"
	},
	"license": "MIT",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "npm run format && npm run check:svelte && npm run lint && npm run test",
		"dev": "vite dev",
		"docker:build": "docker build -f render/Dockerfile -t versatiles-map-animator .",
		"docker:build:gpu": "docker build -f render/Dockerfile --build-arg GPU=true -t versatiles-map-animator:gpu .",
		"format:check": "prettier --log-level=warn --check .",
		"format": "prettier --log-level=warn --write .",
		"inspect": "tsx scripts/inspect-hash.ts",
		"lint": "eslint .",
		"preview": "vite preview",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test": "vitest run",
		"upgrade": "npm-check-updates -u --peer && npm install && npm audit fix"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"@versatiles/style": "^6.4.1",
		"@vitest/coverage-v8": "^5.0.4",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.1",
		"maplibre-gl": "^6.14.0",
		"npm-check-updates": "^23.1.1",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}

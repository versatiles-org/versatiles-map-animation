{
	"name": "versatiles-map-animation",
	"version": "0.1.0",
	"description": "Prototype tool for composing map camera animations on a timeline (VersaTiles).",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/versatiles-org/versatiles-map-animation.git"
	},
	"license": "MIT",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "npm run format && npm run check:svelte && npm run lint && npm run test",
		"dev": "vite dev",
		"format:check": "prettier --log-level=warn --check .",
		"format": "prettier --log-level=warn --write .",
		"inspect": "tsx scripts/inspect-hash.ts",
		"lint": "eslint .",
		"preview": "vite preview",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test": "vitest run",
		"upgrade": "npm-check-updates -u --peer && npm install"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.4",
		"@versatiles/style": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.5",
		"maplibre-gl": "^6.12.0",
		"npm-check-updates": "^23.1.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"cookie": "^0.7.2"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}
